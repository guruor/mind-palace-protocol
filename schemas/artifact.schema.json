{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mind-palace:schema:artifact:0.1.0",
  "title": "Mind Palace artifact envelope",
  "type": "object",
  "required": [
    "protocol",
    "id",
    "kind",
    "title",
    "authority",
    "trust_domain",
    "revision",
    "relations",
    "provenance"
  ],
  "properties": {
    "protocol": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": {"const": "mind-palace"},
        "version": {"$ref": "#/$defs/semver"}
      },
      "additionalProperties": true
    },
    "id": {"type": "string", "minLength": 1},
    "kind": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*$"},
    "methodology": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "version": {"$ref": "#/$defs/semver"}
      },
      "additionalProperties": true
    },
    "title": {"type": "string", "minLength": 1},
    "authority": {
      "enum": ["intent", "configuration", "evidence", "history", "implementation-reference", "derived"]
    },
    "trust_domain": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "target"],
        "properties": {
          "type": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*(?:/[a-z0-9][a-z0-9_-]*)?$"},
          "target": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "locator"],
        "properties": {
          "type": {"type": "string", "minLength": 1},
          "locator": {"type": "string", "minLength": 1},
          "source_version": {"type": "string", "minLength": 1},
          "content_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    }
  }
}
