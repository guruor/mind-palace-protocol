{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mind-palace:schema:migration-plan:0.1.0",
  "title": "Mind Palace document migration plan",
  "type": "object",
  "required": [
    "id",
    "protocol",
    "state",
    "request",
    "target",
    "documents",
    "checks",
    "budget",
    "execution_policy",
    "progress",
    "approval",
    "rollback",
    "validation"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "protocol": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": {"const": "mind-palace"},
        "version": {"$ref": "urn:mind-palace:schema:artifact:0.1.0#/$defs/semver"}
      },
      "additionalProperties": true
    },
    "state": {"enum": ["draft", "reviewed", "approved", "executing", "completed", "blocked", "rolled-back"]},
    "request": {
      "type": "object",
      "required": ["scope_mode", "boundary", "requested_sources"],
      "properties": {
        "scope_mode": {"enum": ["selected", "all-authorized"]},
        "boundary": {"type": "string", "minLength": 1},
        "requested_sources": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "dependency_reads": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "exclusions": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      },
      "additionalProperties": true
    },
    "target": {
      "type": "object",
      "required": ["method", "method_version", "storage_binding"],
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "method_version": {"$ref": "urn:mind-palace:schema:artifact:0.1.0#/$defs/semver"},
        "storage_binding": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_id", "source_locator", "base_revision", "classification", "action", "risks", "transformation"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "source_locator": {"type": "string", "minLength": 1},
          "base_revision": {"type": "string", "minLength": 1},
          "classification": {"enum": ["conformant", "partial", "legacy", "duplicate", "unknown", "out-of-scope"]},
          "target_kind": {"type": ["string", "null"]},
          "action": {"enum": ["retain", "create", "update", "split", "merge", "skip"]},
          "risks": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "relation_targets": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "transformation": {
            "type": "object",
            "required": ["mode", "semantic_impact", "summary"],
            "properties": {
              "mode": {"enum": ["preserve", "structural", "meaning-preserving", "material", "unknown"]},
              "semantic_impact": {"enum": ["none", "low", "material", "unknown"]},
              "summary": {"type": "string", "minLength": 1},
              "preview_locator": {"type": "string", "minLength": 1}
            },
            "allOf": [
              {"if": {"properties": {"mode": {"const": "preserve"}}}, "then": {"properties": {"semantic_impact": {"const": "none"}}}},
              {"if": {"properties": {"mode": {"const": "structural"}}}, "then": {"properties": {"semantic_impact": {"enum": ["none", "low"]}}}},
              {"if": {"properties": {"mode": {"const": "meaning-preserving"}}}, "then": {"properties": {"semantic_impact": {"const": "low"}}}},
              {"if": {"properties": {"mode": {"const": "material"}}}, "then": {"properties": {"semantic_impact": {"const": "material"}}}},
              {"if": {"properties": {"mode": {"const": "unknown"}}}, "then": {"properties": {"semantic_impact": {"const": "unknown"}}}}
            ],
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "checks": {
      "type": "object",
      "required": ["client", "corpus", "execution", "validation"],
      "properties": {
        "client": {"$ref": "#/$defs/checks"},
        "corpus": {"$ref": "#/$defs/checks"},
        "execution": {"$ref": "#/$defs/checks"},
        "validation": {"$ref": "#/$defs/checks"}
      },
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "required": ["allowed", "records", "text_bytes", "attachments", "requests", "batch_size", "delay_seconds", "retry_attempts", "rollback_writes"],
      "properties": {
        "allowed": {"type": "boolean"},
        "records": {"type": "integer", "minimum": 0},
        "text_bytes": {"type": "integer", "minimum": 0},
        "attachments": {"type": "integer", "minimum": 0},
        "requests": {"type": "integer", "minimum": 0},
        "batch_size": {"type": "integer", "minimum": 1},
        "delay_seconds": {"type": "number", "minimum": 0},
        "retry_attempts": {"type": "integer", "minimum": 0},
        "rollback_writes": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "execution_policy": {
      "type": "object",
      "required": ["mode", "max_documents_per_run", "checkpoint_every_documents", "request_headroom", "pause_on_rate_limit", "honor_retry_after"],
      "properties": {
        "mode": {"const": "incremental"},
        "max_documents_per_run": {"type": "integer", "minimum": 1},
        "checkpoint_every_documents": {"type": "integer", "minimum": 1},
        "request_headroom": {"type": "integer", "minimum": 1},
        "pause_on_rate_limit": {"const": true},
        "honor_retry_after": {"const": true}
      },
      "additionalProperties": true
    },
    "progress": {
      "type": "object",
      "required": ["status", "completed_sources", "pending_sources", "failed_sources"],
      "properties": {
        "status": {"enum": ["not-started", "running", "paused", "paused-rate-limit", "completed", "blocked"]},
        "completed_sources": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "pending_sources": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "failed_sources": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "last_checkpoint": {"type": "string", "format": "date-time"},
        "resume_after": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": true
    },
    "approval": {
      "type": "object",
      "required": ["required", "status", "scope_digest", "material_changes_acknowledged"],
      "properties": {
        "required": {"const": true},
        "status": {"enum": ["pending", "approved", "rejected", "expired"]},
        "scope_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "material_changes_acknowledged": {"type": "boolean"},
        "approved_by": {"type": "string", "minLength": 1},
        "approved_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": true
    },
    "rollback": {
      "type": "object",
      "required": ["snapshot_locators", "steps"],
      "properties": {
        "snapshot_locators": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "steps": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": true
    },
    "validation": {
      "type": "object",
      "required": ["checks", "omissions"],
      "properties": {
        "checks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "omissions": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {"properties": {"request": {"properties": {"scope_mode": {"const": "selected"}}}}},
      "then": {"properties": {"request": {"properties": {"requested_sources": {"minItems": 1}}}}}
    },
    {
      "if": {"properties": {"state": {"enum": ["approved", "executing", "completed", "rolled-back"]}}},
      "then": {
        "properties": {
          "budget": {"properties": {"allowed": {"const": true}}},
          "approval": {
            "required": ["approved_by", "approved_at"],
            "properties": {"status": {"const": "approved"}}
          }
        }
      }
    }
  ],
  "$defs": {
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "status"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "status": {"enum": ["passed", "failed", "unknown", "not-applicable"]},
          "evidence": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
