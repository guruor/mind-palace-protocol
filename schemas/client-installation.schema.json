{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mind-palace:schema:client-installation:0.1.0",
  "title": "Mind Palace client installation receipt",
  "type": "object",
  "required": [
    "protocol",
    "package",
    "client",
    "instance",
    "binding",
    "methodologies",
    "access_mode",
    "previous_installation",
    "checks",
    "migration_ready"
  ],
  "properties": {
    "protocol": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": {"const": "mind-palace"},
        "version": {"$ref": "#/$defs/semver"}
      },
      "additionalProperties": true
    },
    "package": {
      "type": "object",
      "required": ["locator", "source_version"],
      "properties": {
        "locator": {"type": "string", "minLength": 1},
        "source_version": {"type": "string", "minLength": 1},
        "content_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      },
      "additionalProperties": true
    },
    "client": {
      "type": "object",
      "required": ["id", "adapter_version"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "adapter_version": {"$ref": "#/$defs/semver"}
      },
      "additionalProperties": true
    },
    "instance": {
      "type": "object",
      "required": ["id", "trust_domain"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "trust_domain": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "binding": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "methodologies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "version"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "version": {"$ref": "#/$defs/semver"}
        },
        "additionalProperties": true
      }
    },
    "access_mode": {"enum": ["read", "propose", "update"]},
    "previous_installation": {
      "type": "object",
      "required": ["state", "resolution"],
      "properties": {
        "state": {
          "enum": [
            "absent",
            "same",
            "older-compatible",
            "older-migration-required",
            "newer",
            "unversioned",
            "invalid"
          ]
        },
        "version": {"$ref": "#/$defs/semver"},
        "source_version": {"type": "string", "minLength": 1},
        "resolution": {
          "enum": [
            "not-needed",
            "approved-upgrade",
            "parallel-install",
            "approved-downgrade",
            "retained-read-only",
            "blocked"
          ]
        },
        "approval_reference": {"type": "string", "minLength": 1},
        "prior_write_authority": {
          "enum": ["disabled", "read-only", "separate-instance", "unknown"]
        }
      },
      "additionalProperties": true
    },
    "checks": {
      "type": "object",
      "required": [
        "package_integrity",
        "protocol_resolution",
        "methodology_resolution",
        "binding_resolution",
        "trust_isolation",
        "read_probe",
        "proposal_probe",
        "conflict_probe",
        "handoff_probe"
      ],
      "properties": {
        "package_integrity": {"$ref": "#/$defs/check"},
        "protocol_resolution": {"$ref": "#/$defs/check"},
        "methodology_resolution": {"$ref": "#/$defs/check"},
        "binding_resolution": {"$ref": "#/$defs/check"},
        "trust_isolation": {"$ref": "#/$defs/check"},
        "read_probe": {"$ref": "#/$defs/check"},
        "proposal_probe": {"$ref": "#/$defs/check"},
        "conflict_probe": {"$ref": "#/$defs/check"},
        "handoff_probe": {"$ref": "#/$defs/check"}
      },
      "additionalProperties": true
    },
    "migration_ready": {"type": "boolean"}
  },
  "additionalProperties": true,
  "$defs": {
    "check": {"enum": ["pass", "fail", "not-run", "not-applicable"]},
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    }
  }
}
