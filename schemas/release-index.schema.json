{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mind-palace:schema:release-index:0.1.0",
  "title": "Mind Palace release index",
  "type": "object",
  "required": ["protocol", "source", "resources"],
  "properties": {
    "protocol": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": {"const": "mind-palace"},
        "version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["locator_template", "revision_from"],
      "properties": {
        "locator_template": {"type": "string", "minLength": 1},
        "revision_from": {"const": "release-record"}
      },
      "additionalProperties": false
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "digest", "bytes", "class", "cache", "purpose"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
          "bytes": {"type": "integer", "minimum": 0},
          "class": {"enum": ["core", "on-demand", "maintenance"]},
          "cache": {"enum": ["always", "automatic", "never"]},
          "purpose": {"type": "string", "minLength": 1}
        },
        "allOf": [
          {"if": {"properties": {"class": {"const": "core"}}}, "then": {"properties": {"cache": {"const": "always"}}}},
          {"if": {"properties": {"class": {"const": "maintenance"}}}, "then": {"properties": {"cache": {"const": "never"}}}}
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
